body {
  margin: 0;
  font-family: Georgia, serif;
  background-color: #ebdcc5;
  color: #3b2a1a;
  text-align: center;
}

.hero {
  padding: 50px 20px;
}

.logo {
  width: 250px;
  max-width: 80%;
}

h1 {
  margin: 20px 0;
  font-size: 2rem;
}

.book-btn {
  display: inline-block;
  padding: 15px 30px;
  background-color: #3b2a1a;
  color: white;
  text-decoration: none;
  font-weight: bold;
  border-radius: 8px;
  margin-top: 15px;
}

.pricing-card {
  background: #f7eed8;
  border: 2px solid #3b2a1a;
  padding: 20px;
  margin: 15px auto;
  width: 90%;
  max-width: 500px;
  border-radius: 8px;
}

footer {
  margin-top: 40px;
  padding: 20px;
  border-top: 1px solid #3b2a1a;
}
